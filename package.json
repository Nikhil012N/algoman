{
  "name": "algoman",
  "version": "0.1.0",
  "description": "High-performance enterprise algorithms, non-native data structures, and resilient execution framework for TypeScript & Node.js.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "algorithms",
    "data-structures",
    "deque",
    "red-black-tree",
    "treap",
    "segment-tree",
    "aho-corasick",
    "consistent-hashing",
    "rate-limiter",
    "circuit-breaker",
    "bloom-filter",
    "hyperloglog",
    "typescript"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "author": "Nikhil",
  "license": "MIT",
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "terser": "^5.51.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
